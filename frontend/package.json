  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "3.0.6"
  }
