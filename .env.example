APP_ENV=development
APP_SECRET_KEY=generate-a-random-session-secret-with-at-least-32-bytes
MODEL_CREDENTIAL_ENCRYPTION_KEY=generate-a-separate-model-key-with-at-least-32-bytes
SERVICE_API_KEY_PEPPER=generate-a-separate-api-key-pepper-with-at-least-32-bytes
RESULT_DOWNLOAD_SIGNING_KEY=generate-a-separate-download-key-with-at-least-32-bytes
LOG_LEVEL=INFO
# development 可使用 * 允许内网调试；production 请填写明确的前端来源列表
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_human_service_platform
DB_USER=root
DB_PASSWORD=replace-with-database-password

XIAOZHI_API_URL=https://replace-with-environment-url/device/manual-add
XIAOZHI_TOKEN=replace-with-environment-token
XIAOZHI_JSESSIONID=replace-with-environment-session-id
XIAOZHI_TIMEOUT_SECONDS=10

# MinIO 图片存储（development 与 production 使用不同 Bucket）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=digital-human-service-platform-development
MINIO_SECURE=false
MAX_XIAOZHI_SERVICE_ASSET_BYTES=10485760
MAX_XIAOZHI_SERVICE_VIDEO_BYTES=209715200

# 前端 AI 服务媒体与异步任务
MAX_AI_AUDIO_BYTES=20971520
MAX_AI_IMAGE_BYTES=10485760
MAX_AI_PROMPT_CHARS=4000
MAX_AI_AUDIO_SECONDS=60
AI_TASK_INPUT_PREFIX=tasks/input
AI_TASK_RESULT_PREFIX=tasks/result
AI_TASK_INPUT_RETENTION_HOURS=24
AI_RESULT_RETENTION_DAYS=7
AI_RESULT_DOWNLOAD_TTL_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=120
WORKER_LEASE_RENEW_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=4
WORKER_MAX_CONCURRENCY=4

# 小智调用中间件使用的代理密钥（仅服务端使用，不返回给前端）
LLM_PROXY_API_KEY=replace-with-proxy-api-key
LLM_PROXY_FALLBACK_TEXT=抱歉，服务暂时不可用，请稍后再试。
LLM_PROXY_STREAM_INTERRUPTION_TEXT=抱歉，回答生成被中断，请稍后再试。
LLM_PROXY_MAX_MESSAGES=50
LLM_PROXY_MAX_MESSAGE_CHARS=8000
LLM_PROXY_MAX_TOTAL_CHARS=30000
EXTERNAL_PROXY_TIMEOUT_SECONDS=30

ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
AUTH_COOKIE_TTL_MINUTES=480
# 使用 HTTPS 时设为 true；如果暂时通过 HTTP+IP 访问生产后台，设为 false
AUTH_COOKIE_SECURE=true
